<form class="kripta-sheet-form">
  <p class="kripta-settings-help">
    {{localize 'KRIPTA.Settings.Help.BeforeServerLink'}}
    <a href="{{serverDownloadUrl}}" target="_blank" rel="noopener noreferrer">{{localize 'KRIPTA.Settings.Help.ServerLink'}}</a>{{localize 'KRIPTA.Settings.Help.AfterServerLink'}}
    <a href="{{serverSetupDocumentationUrl}}" target="_blank" rel="noopener noreferrer">{{localize 'KRIPTA.Settings.Help.ServerSetupDocumentationLink'}}</a>{{localize 'KRIPTA.Settings.Help.BetweenDocumentationLinks'}}
    <a href="{{cardSetDocumentationUrl}}" target="_blank" rel="noopener noreferrer">{{localize 'KRIPTA.Settings.Help.CardSetDocumentationLink'}}</a>{{localize 'KRIPTA.Settings.Help.BetweenDocumentationLinks'}}
    <a href="{{localizationDocumentationUrl}}" target="_blank" rel="noopener noreferrer">{{localize 'KRIPTA.Settings.Help.LocalizationDocumentationLink'}}</a>{{localize 'KRIPTA.Settings.Help.AfterDocumentationLink'}}
  </p>

  <div class="form-group">
    <label>{{localize 'KRIPTA.Label.ServerUrl'}}</label>
    <input type="text" name="serverUrl" value="{{serverUrl}}" autocomplete="off">
  </div>

  <fieldset class="kripta-fieldset">
    <legend>{{localize 'KRIPTA.Label.Writer'}}</legend>

    <div class="form-group">
      <label>{{localize 'KRIPTA.Label.Id'}}</label>
      <input type="text" name="writerId" value="{{writerId}}" autocomplete="off">
    </div>

    <div class="form-group">
      <label>{{localize 'KRIPTA.Label.Key'}}</label>
      <input type="password" name="writerKey" value="{{writerKey}}" autocomplete="off">
    </div>
  </fieldset>

  <fieldset class="kripta-fieldset">
    <legend>{{localize 'KRIPTA.Label.Reader'}}</legend>

    <div class="form-group">
      <label>{{localize 'KRIPTA.Label.Id'}}</label>
      <input type="text" name="readerId" value="{{readerId}}" autocomplete="off">
    </div>

    <div class="form-group">
      <label>{{localize 'KRIPTA.Label.Key'}}</label>
      <input type="password" name="readerKey" value="{{readerKey}}" autocomplete="off">
    </div>
  </fieldset>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="test-server">
      <i class="fas fa-heartbeat"></i>
      {{localize 'KRIPTA.Button.TestServer'}}
    </button>

    <button type="button" data-action="test-auth">
      <i class="fas fa-user-check"></i>
      {{localize 'KRIPTA.Button.TestAuth'}}
    </button>

    <button type="button" data-action="thanks-author">
      <i class="fas fa-hand-holding-heart"></i>
      {{localize 'KRIPTA.Button.ThanksAuthor'}}
    </button>

    <button type="submit" class="default">
      <i class="fas fa-save"></i>
      {{localize 'KRIPTA.Button.SaveChanges'}}
    </button>
  </footer>
</form>
