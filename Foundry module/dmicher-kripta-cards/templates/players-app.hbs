<div class="kripta-window-layout">
  <div class="kripta-window-scroll">
    <section class="kripta-players-list">
      {{#each rows}}
      <article class="kripta-player-row">
          <div class="kripta-player-row__head">
              <div>
                  <h3>{{foundryUserName}}</h3>
                  <div class="notes">
                      <b>{{localize 'KRIPTA.Label.Role'}}</b>: {{#if isGM}}{{localize 'KRIPTA.Role.GM'}}{{else}}{{localize 'KRIPTA.Role.Player'}}{{/if}} · {{#if active}}<span style="color:darkgreen">{{localize 'KRIPTA.Status.InGame'}}</span>{{else}}<span style="color:brown">{{localize 'KRIPTA.Status.Offline'}}</span>{{/if}}
                  </div>
                  <div class="kripta-player-row__binding">
                      <div class="kripta-player-row__server-name">
                          <b>{{localize 'KRIPTA.Label.Binding'}}</b>:
                          {{#if boundPlayer}}
                          {{boundPlayer.name}} · {{#if cardsCount}} {{localize 'KRIPTA.Binding.CardsIssued'}}
                          <span class="kripta-badge kripta-badge--hint"
                                data-tooltip="{{localize 'KRIPTA.Binding.CardsCountHint'}}"
                                data-tooltip-direction="UP"
                                title="{{localize 'KRIPTA.Binding.CardsCountHint'}}"
                                aria-label="{{localize 'KRIPTA.Binding.CardsCountHint'}}">
                              {{cardsCount}}
                          </span>
                          {{else}}{{localize 'KRIPTA.Binding.NoCards'}}{{/if}}
                          {{else}}{{localize 'KRIPTA.Binding.NotBound'}}{{/if}}
                      </div>
                      {{#if boundPlayer}}<div class="notes" style="margin-top: 5px"><i>{{boundPlayer.comment}}</i></div>{{/if}}
                  </div>
              </div>
          </div>
        <div class="kripta-player-row__body">
          <div class="kripta-inline-actions kripta-player-row__actions">
            <button type="button" data-action="bind" data-user-id="{{foundryUserId}}">{{localize 'KRIPTA.Button.Bind'}}</button>
            <button type="button" data-action="unbind" data-user-id="{{foundryUserId}}">{{localize 'KRIPTA.Button.Unbind'}}</button>
            <button type="button" data-action="open-cards" data-user-id="{{foundryUserId}}">{{localize 'KRIPTA.Window.MyCards'}}</button>
            <button type="button" data-action="give-card" data-user-id="{{foundryUserId}}">{{localize 'KRIPTA.Button.GiveCard'}}</button>
          </div>
        </div>
      </article>
      {{/each}}
    </section>
  </div>

  <footer class="sheet-footer flexrow kripta-fixed-footer">
    <button type="button" data-action="refresh">{{localize 'KRIPTA.Button.Refresh'}}</button>
    <button type="button" data-action="registry">{{localize 'KRIPTA.Button.Registry'}}</button>
  </footer>
</div>
