<form class="kripta-sheet-form">
  <div class="form-group">
    <label>{{localize 'KRIPTA.Label.Category'}}</label>
    <select name="level">
      {{#each levels}}
      <option value="{{id}}" {{#if (eq ../selectedLevel id)}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize 'KRIPTA.Label.Mode'}}</label>
    <div class="kripta-radio-row">
      <label><input type="radio" name="mode" value="random" {{#unless isManual}}checked{{/unless}}> {{localize 'KRIPTA.Mode.Random'}}</label>
      <label><input type="radio" name="mode" value="manual" {{#if isManual}}checked{{/if}}> {{localize 'KRIPTA.Mode.Manual'}}</label>
    </div>
  </div>

  {{#if isManual}}
  <div class="form-group">
    <label>{{localize 'KRIPTA.Label.Card'}}</label>
    <select name="cardNumber">
      {{#each cards}}
      <option value="{{number}}" {{#if (eq ../selectedNumber number)}}selected{{/if}}>{{nameText}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  <footer class="sheet-footer flexrow">
    <button type="submit" class="default">{{localize 'KRIPTA.Button.Give'}}</button>
    <button type="button" onclick="this.closest('.app').querySelector('.header-button.close')?.click()">{{localize 'KRIPTA.Button.Cancel'}}</button>
  </footer>
</form>
