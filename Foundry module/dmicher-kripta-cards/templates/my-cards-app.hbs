{{#if emptyState}}
<div class="kripta-empty-state">{{localize 'KRIPTA.Template.EmptyCatalog'}}</div>
{{else}}
<div class="kripta-browser kripta-browser--resizable" data-browser-root>
  <aside class="kripta-browser__sidebar">
    <div class="kripta-browser__sidebar-scroll">
      {{#each levels}}
      <button type="button" class="kripta-level-button {{#if isActive}}is-active{{/if}}" data-level-id="{{id}}"
        title="{{descriptionText}}">
        {{name}}
      </button>
      {{/each}}
    </div>
  </aside>

  <div class="kripta-browser__resizer" data-action="resize-sidebar"></div>
  <section class="kripta-browser__main">
    <div class="kripta-browser__main-scroll">
      <header class="kripta-browser__header">
        <div>
          <h2>{{playerTitle}}</h2>
          <div class="notes kripta-level-description">{{{activeLevel.descriptionHtml}}}</div>
        </div>
        <div class="kripta-browser__toolbar">
          <input type="text" name="search" value="{{search}}" placeholder="{{localize 'KRIPTA.Placeholder.Search'}}">
          <button type="button" data-action="set-view" data-view="table"
            class="{{#if isTable}}active{{/if}}">{{localize 'KRIPTA.View.Table'}}</button>
          <button type="button" data-action="set-view" data-view="tiles"
            class="{{#if isTiles}}active{{/if}}">{{localize 'KRIPTA.View.Tiles'}}</button>
        </div>
      </header>

      {{#if isTable}}
      <div class="kripta-table-list">
        {{#each items}}
        <article class="kripta-row-card" data-card-key="{{level}}:{{number}}" data-search-text="{{searchText}}">
          <div class="kripta-row-card__image">
            {{#if imageUrl}}<img src="{{imageUrl}}" alt="{{nameText}}">{{/if}}
          </div>
          <div class="kripta-row-card__content">
            <h3>{{{nameHtml}}} <span class="kripta-badge">{{count}}</span></h3>
            {{#if descriptionTablePreviewHtml}}<div class="kripta-html">{{{descriptionTablePreviewHtml}}}</div>{{/if}}
          </div>
          <div class="kripta-row-card__actions">
            <button type="button" data-action="use">{{localize 'KRIPTA.Button.Use'}}</button>
            <button type="button" data-action="info">{{localize 'KRIPTA.Button.Info'}}</button>
            {{#if ../isGM}}<button type="button" data-action="take">{{localize 'KRIPTA.Button.Take'}}</button>{{/if}}
          </div>
        </article>
        {{/each}}
      </div>
      {{else}}
      <div class="kripta-tile-grid">
        {{#each items}}
        <article class="kripta-card-tile" data-card-key="{{level}}:{{number}}" data-search-text="{{searchText}}" title="{{descriptionText}}">
          <div class="kripta-card-tile__image-wrap">{{#if imageUrl}}<img src="{{imageUrl}}" alt="{{nameText}}">{{/if}}</div>
          <div class="kripta-card-tile__name">{{{nameHtml}}}</div>
          <div class="notes">{{localize 'KRIPTA.Label.Count'}}: {{count}}</div>
          {{#if descriptionPreviewHtml}}<div class="notes kripta-card-tile__description">{{{descriptionPreviewHtml}}}</div>{{/if}}
          <div class="kripta-inline-actions">
            <button type="button" data-action="use">{{localize 'KRIPTA.Button.Use'}}</button>
          </div>
        </article>
        {{/each}}
      </div>
      {{/if}}
    </div>

    <footer class="sheet-footer flexrow kripta-browser__footer">
      <button type="button" data-action="refresh">{{localize 'KRIPTA.Button.Refresh'}}</button>
      <button type="button" data-action="request">{{localize 'KRIPTA.Button.RequestCard'}}</button>
    </footer>
  </section>
</div>
{{/if}}
