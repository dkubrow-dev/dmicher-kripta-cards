<div class="kripta-window-layout">
  <div class="kripta-window-scroll">
    <div class="kripta-table-wrap" style="overflow: auto;">
      <table class="kripta-grid" style="width: max-content; min-width: 100%; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="white-space: nowrap;">Имя</th>
            <th style="white-space: nowrap;">Комментарий</th>
            <th style="white-space: nowrap;">Типов карточек</th>
          </tr>
        </thead>
        <tbody>
          {{#each players}}
          <tr data-player-guid="{{guid}}" class="{{#if isSelected}}is-selected{{/if}}">
            <td style="white-space: nowrap;">{{name}}</td>
            <td style="white-space: nowrap;">{{comment}}</td>
            <td style="white-space: nowrap; text-align: center;">{{cardsCount}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <footer class="sheet-footer flexrow kripta-fixed-footer">
    <button type="button" data-action="add">Добавить</button>
    <button type="button" data-action="edit" {{#unless hasPlayers}}disabled{{/unless}}>Изменить</button>
    <button type="button" data-action="delete" {{#unless hasPlayers}}disabled{{/unless}}>Удалить</button>
    <button type="button" data-action="refresh">Обновить</button>
  </footer>
</div>