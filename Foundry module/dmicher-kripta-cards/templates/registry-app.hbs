<div class="kripta-window-layout">
  <div class="kripta-window-scroll">
    <div class="kripta-table-wrap" style="overflow: auto;">
      <table class="kripta-grid" style="width: max-content; min-width: 100%; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="white-space: nowrap;">{{localize 'KRIPTA.Label.Name'}}</th>
            <th style="white-space: nowrap;">{{localize 'KRIPTA.Label.Pin'}}</th>
            <th style="white-space: nowrap;">{{localize 'KRIPTA.Label.Comment'}}</th>
            <th style="white-space: nowrap;">{{localize 'KRIPTA.Label.CardTypes'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each players}}
          <tr data-player-guid="{{guid}}" class="{{#if isSelected}}is-selected{{/if}}">
            <td style="white-space: nowrap;">{{name}}</td>
            <td style="white-space: nowrap;">{{pin}}</td>
            <td style="white-space: nowrap;">{{comment}}</td>
            <td style="white-space: nowrap; text-align: center;">{{cardsCount}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <footer class="sheet-footer flexrow kripta-fixed-footer">
    <button type="button" data-action="add">{{localize 'KRIPTA.Button.Add'}}</button>
    <button type="button" data-action="edit" {{#unless hasPlayers}}disabled{{/unless}}>{{localize 'KRIPTA.Button.Edit'}}</button>
    <button type="button" data-action="delete" {{#unless hasPlayers}}disabled{{/unless}}>{{localize 'KRIPTA.Button.Delete'}}</button>
    <button type="button" data-action="refresh">{{localize 'KRIPTA.Button.Refresh'}}</button>
  </footer>
</div>
