<section class="kripta-card-details">
  <h2>{{{meta.nameHtml}}}</h2>
  <div class="notes">{{levelName}}</div>
  <div class="kripta-html">{{{meta.descriptionHtml}}}</div>

  <div class="kripta-inline-actions">
    <button type="button" data-action="output">{{localize 'KRIPTA.Button.Output'}}</button>
    <button type="button" data-action="request">{{localize 'KRIPTA.Button.Request'}}</button>
    {{#if isGM}}<button type="button" data-action="give">{{localize 'KRIPTA.Button.Give'}}</button>{{/if}}
  </div>

  {{#if imageUrl}}
  <div class="kripta-card-details__image-wrap">
    <img src="{{imageUrl}}" alt="{{meta.nameText}}" class="kripta-card-details__image">
  </div>
  {{/if}}
</section>
