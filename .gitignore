# Сборочные артефакты фронта.
# Если dist/build являются публикуемой частью модуля и должны храниться в git — убери эти строки.
dist/
build/
.temp/
tmp/


# =========================
# Foundry VTT
# =========================

# НЕ игнорируем module.json, scripts/, templates/, styles/, lang/, assets/
# Они обычно должны быть в репозитории модуля.

# Локальная пользовательская папка Foundry, если случайно положили репозиторий рядом
Data/
Config/
Logs/
worlds/
systems/

# Но сам модуль можно хранить в репозитории.
# Если репозиторий лежит прямо в Data/modules/<module-id>, эти правила не мешают.

# Runtime/lock-файлы compendium packs Foundry
packs/**/CURRENT
packs/**/LOCK
packs/**/*.ldb
packs/**/*.log
packs/**/*.sqlite
packs/**/*.sqlite3
packs/**/*.sqlite-shm
packs/**/*.sqlite-wal

# Экспортированные релизы модуля
*.zip
*.tgz

# Локальные manifest/package файлы для проверки, если создаёшь их скриптами
manifest.local.json
module.local.json


